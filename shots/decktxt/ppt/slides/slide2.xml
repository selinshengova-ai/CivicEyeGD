" y="2209800"/><a:ext cx="2895600" cy="682752"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"/><a:lstStyle/><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="112000"/></a:lnSpc></a:pPr><a:r><a:rPr sz="2000" b="1"><a:solidFill><a:srgbClr val="1B4D3E"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/></a:rPr><a:t>Достъпната среда е невидима</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="TextBox 11"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F50D7BC0-8D0F-4A61-A4EF-4C0566AB5EC6}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="1028700" y="2857500"/><a:ext cx="2895600" cy="2000250"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"/><a:lstStyle/><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="138000"/></a:lnSpc></a:pPr><a:r><a:rPr sz="1400"><a:solidFill><a:srgbClr val="1D3028"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/></a:rPr><a:t>Проблемът се снима и качва в социалните мрежи, където потъва след ден-два. Няма категория, адрес и координати, по които да се търси.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="TextBox 12"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{0A42CBC2-6901-4530-996E-25EA32D79072}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="4648200" y="2857500"/><a:ext cx="2895600" cy="2000250"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"/><a:lstStyle/><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="138000"/></a:lnSpc></a:pPr><a:r><a:rPr sz="1400"><a:solidFill><a:srgbClr val="1D3028"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/></a:rPr><a:t>Гражданинът не разбира дали някой е видял сигнала и дали е приключен. Службата няма класация по тежест, за да преценява с какво да започне.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="TextBox 13"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{051B6FAB-5BAA-4B2B-8F10-58434E7D5DDE}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="8267700" y="2857500"/><a:ext cx="2895600" cy="2000250"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"/><a:lstStyle/><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="138000"/></a:lnSpc></a:pPr><a:r><a:rPr sz="1400"><a:solidFill><a:srgbClr val="1D3028"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/></a:rPr><a:t>Пъпки, липсващи рампи и неосветени улици в малкия град не влизат в официалните отчети, защото никой не ги събира на едно място.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="TextBox 14"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A34E34C4-FF08-4A0B-93C6-2DF4DAF9FD42}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="762000" y="5867400"/><a:ext cx="10668000" cy="419100"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"/><a:lstStyle/><a:p><a:pPr algn="l"/><a:r><a:rPr sz="1400" i="1"><a:solidFill><a:srgbClr val="66766D"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/></a:rPr><a:t>CivicEye GD затваря този цикъл: сигналът се нанася, оценява и проследява на едно място.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>
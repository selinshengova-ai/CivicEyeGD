# .NET generated files
bin/
obj/

# Запазени резултати от тестове: числата в тях остаряват още с първата
# следваща промяна и лесно се препречат в документите.
TestResults/

# Publish output for hosting — never committed
publish*/

# IDE files
.vs/
.vscode/
*.user
*.suo

# Logs
*.log

# Local databases
*.db
*.db-shm
*.db-wal

# Environment files and secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Качени файлове (снимки към сигнали)
App_Data/

# Поверителни бележки: паролите за демонстрацията не се качват в
# хранилището и не влизат в архива за олимпиадата
.private/

# Database backups
App_Data-backup/

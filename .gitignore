*.db-wal

# Environment files and secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Качени файлове (снимки към сигнали)
App_Data/

# Поверителни бележки: паролите за демонстрацията не се качват в
# хранилището и не влизат в архива за олимпиадата
.private/

# Database backups
App_Data-backup/

# Временно: изход от локални проверки и готовият архив за олимпиадата.
# И двете се генерират наново с една команда, затова не търсят място в
# историята на кода. Папките, които вече са били добавени, трябва да се
# махнат с git rm -r --cached — самият файл ги спира само оттук нататък.
shots/
submission/

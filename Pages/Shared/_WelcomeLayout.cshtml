@*
    CivicEye GD — втората, минимална обвивка на сайта: за екрана преди влизане
    и за страниците с грешки. Липсващото меню и футерът не са забравени, а са
    решени: такива екрани трябва да се изобразяват при всяко състояние на
    сесията, дори когато останалата част от приложението не работи.
*@

<!DOCTYPE html>
<html lang="bg" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123B32" />
    <title>@ViewData["Title"] — CivicEye GD</title>
    
    <script>
        // Скриптът за тема е повторение от голямата обвивка, умишлено: всяка
        // обвивка е самостоятелна и не дърпа към себе си чужди файлове. Без този
        // ред всяка тъмна тема би мигнала в бяло при зареждане на екрана.
        try {
            const savedTheme = localStorage.getItem("civic-theme");
            const theme = savedTheme === "dark" ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", theme);
            document.addEventListener("DOMContentLoaded", function () {
                if (document.body) {
                    document.body.setAttribute("data-theme", theme);
                }
            });
        } catch {
            document.documentElement.setAttribute("data-theme", "light");
        }
    </script>
    
    <!-- Bootstrap -->
    @* И тук редът на файловете е като в голямата обвивка: Bootstrap пръв, после
        собствените стилове — така един и същ CSS работи еднакво и в двете обвивки. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Новите разделени CSS файлове -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/CivicEyeGD.styles.css" asp-append-version="true" />
</head>
<body class="civic-site">

    <!-- Тук няма хедър и футър, за да изглежда Welcome страницата като самостоятелен екран -->
    @* Липсата е съзнателна и заради надеждността: менюто изисква данни за
        влезлия и неговите права, а при грешка точно те могат да са причината —
        затова екранът се изобразява без тях, а не се срива заради тях. *@
    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Скрипт за смяна на темата (ако решиш да добавиш бутон на Welcome страницата) -->
    @* Тук site.js не се зарежда изобщо: той работи по елементите на менюто,
        а менюто го няма в тази обвивка — излишно теглене и грешки в
        конзолата биха издали небрежност. *@
    <script>
        // Същата логика като в голямата обвивка, но съкратена: бутона за тема
        // го няма на този екран, затова предпазните извиквания го подминават,
        // а запазената тема се прилага пак — посетителят я е избрал другаде.
        (() => {
            const root = document.documentElement;
            const themeButton = document.getElementById("themeToggle"); // Ако има такъв бутон

            function applyTheme(theme) {
                const isDark = theme === "dark";
                const themeValue = isDark ? "dark" : "light";

                root.setAttribute("data-theme", themeValue);
                if (document.body) {
                    document.body.setAttribute("data-theme", themeValue);
                }

                themeButton?.setAttribute("aria-pressed", String(isDark));
                try { localStorage.setItem("civic-theme", themeValue); } catch {}
            }

            // Слушателят е готов предварително: добави ли се някога бутон с
            // очакваното име, темата ще се превключва веднага, без нова редакция
            // на този файл — кодът само го подмина, докато бутона липсва.
            themeButton?.addEventListener("click", () => {
                const newTheme = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
                applyTheme(newTheme);
            });

            // Операторът „или“ създава стълбица от запасни варианти: първо
            // запазеният избор, после това, което стои в маркировката, и накрая
            // светлата тема като сигурна последна инстанция.
            const savedTheme = localStorage.getItem("civic-theme") || root.getAttribute("data-theme") || "light";
            applyTheme(savedTheme);
        })();
    </script>
    
    @* И тук секцията за скриптове е незадължителна: екран, който я ползва,
        не трябва да се връща към пълната обвивка само заради един файл. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
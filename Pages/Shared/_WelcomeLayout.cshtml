@*
    CivicEye GD — втората, минимална обвивка на сайта: за екрана преди влизане
    и за страниците с грешки. Липсващото меню и футерът не са забравени, а са
    решени: такива екрани трябва да се изобразяват при всяко състояние на
    сесията, дори когато останалата част от приложението не работи.
*@

<!DOCTYPE html>
<html lang="bg" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123B32" />
    <title>@ViewData["Title"] — CivicEye GD</title>
    
    <script>
        // Скриптът за тема е повторение от голямата обвивка, умишлено: всяка
        // обвивка е самостоятелна и не дърпа към себе си чужди файлове. Без този
        // ред всяка тъмна тема би мигнала в бяло при зареждане на екрана.
        try {
            const savedTheme = localStorage.getItem("civic-theme");
            const theme = savedTheme === "dark" ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", theme);
            document.addEventListener("DOMContentLoaded", function () {
                if (document.body) {
                    document.body.setAttribute("data-theme", theme);
                }
            });
        } catch {
            document.documentElement.setAttribute("data-theme", "light");
        }
    </script>
    
    <!-- Bootstrap -->
    @* И тук редът на файловете е като в голямата обвивка: Bootstrap пръв, после
        собствените стилове — така един и същ CSS работи еднакво и в двете обвивки. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Новите разделени CSS файлове -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
</head>
<body class="civic-site">

    <!-- Тук няма хедър и футър, за да изглежда Welcome страницата като самостоятелен екран -->
    @* Липсата е съзнателна и заради надеждността: менюто изисква данни за
        влезлия и неговите права, а при грешка точно те могат да са причината —
        затова екранът се изобразява без тях, а не се срива заради тях. *@
    <main role="main" class="site-main">
        @RenderBody()
    </main>

    @* Този футер е статичен: не чете база, не пита за сесия и не зависи от
       менюто, затова не руши правилството екранът да се изобразява при всяко
       състояние. Посочването на лиценза и връзката към текстовете за правата
       не бива да изисква вход — регламентът ги чете като видими, не като
       скрити след презадената врата. *@
    <footer class="civic-footer">
        <div class="container civic-footer-inner">
            <a class="civic-footer-brand" asp-page="/Welcome">CivicEye <span>GD</span></a>
            <p class="civic-footer-text">Платформа за граждански сигнали · Гоце Делчев</p>
            <a class="civic-footer-link" asp-page="/Privacy">Поверителност</a>
            <a class="civic-footer-link" asp-page="/Credits">Кредити</a>
            <span class="civic-footer-year">© @DateTime.Now.Year · GPL-3.0</span>
        </div>
    </footer>

    @* Тегли се само jQuery: той е нужният на проверките на формите, които
       страниците с вход и регистрация качват по-долу. Библиотеката на
       Bootstrap за скриптовете остава за голямата обвивка — тук няма
       сгъваемо или падащо меню, което да я разчита, а излишните файлове
       се виждат в мрежовия панел на всеки, който отвори страницата. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        // Същата логика като в голямата обвивка, но съкратена до
        // прилагането: бутонът за тема го няма на този екран, затова тук
        // се чете само запазеният избор — посетителят го е направил другаде.
        (() => {
            const root = document.documentElement;

            function applyTheme(theme) {
                const themeValue = theme === "dark" ? "dark" : "light";

                root.setAttribute("data-theme", themeValue);
                if (document.body) {
                    document.body.setAttribute("data-theme", themeValue);
                }

                try { localStorage.setItem("civic-theme", themeValue); } catch {}
            }

            // Операторът „или“ създава стълбица от запасни варианти: първо
            // запазеният избор, после това, което стои в маркировката, и накрая
            // светлата тема като сигурна последна инстанция.
            const savedTheme = localStorage.getItem("civic-theme") || root.getAttribute("data-theme") || "light";
            applyTheme(savedTheme);
        })();
    </script>
    
    @* И тук секцията за скриптове е незадължителна: екран, който я ползва,
        не трябва да се връща към пълната обвивка само заради един файл. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
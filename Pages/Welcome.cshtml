@page "/Welcome"
@*
    CivicEye GD — посрещането на посетител, който още не е влязъл.
    Екранът умишлено държи по-малко функционалност от целия сайт:
    тук се търси само изборът между вход и регистрация.
*@

@* Проектът изисква вход за страниците по подразбиране; този атрибут прави
    изключение, защото в противен случай новият посетител — именно той е
    адресат на страницата — никога няма да я види, а само екрана за вход. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@{
    // Избрана е втората обвивка без меню: входният екран е самостоятелен
    // и не зависи от състоянието на влизане, затова се изобразява чисто
    // и за влезлия, и за госта, без препратки към лични страници.
    Layout = "_WelcomeLayout";
    // Заглавието служи за табата на браузъра; поздравът на екрана е отделен
    // текст, защото е по-дълъг от заглавие и не бива да го споделя.
    ViewData["Title"] = "Добре дошли";
}

<div class="home-page">
    <section class="home-hero">

        <div class="home-hero-content">

            <span class="home-eyebrow">
                <span class="home-eyebrow-dot"></span>
                CIVICEYE GD · ГОЦЕ ДЕЛЧЕВ
            </span>

            <h1>Виж проблема. Промени града.</h1>

            <p class="home-intro">
                Всяка промяна започва с някого, който забелязва
                проблема. Присъедини се към общността и помогни
                за по-достъпна градска среда.
            </p>

            @* Двата бутона водят към страниците на профила. Връзките се
                генерират от адресите на страниците чрез tag helper, а не са
                преписани на ръка: преименува ли се страница, препратките се
                оправят на едно място, вместо да оставят счупени пътища. *@
            <div class="home-account-actions">
                <p>Твоят град. Твоят глас. Твоята промяна.</p>

                <div class="home-account-buttons">

                    <a asp-page="/Account/Login"
                       class="home-button-primary">
                        Вход
                        <span aria-hidden="true">→</span>
                    </a>

                    <a asp-page="/Account/Register"
                       class="home-button-secondary">
                        Регистрация
                    </a>

                </div>
            </div>

            <div class="home-hero-note">
                <span aria-hidden="true">◎</span>
                По-достъпна градска среда започва с общи усилия.
            </div>

        </div>

        @* Визуалът е копие от този на началната страница: изцяло декоративен,
            затова целият блок е скриен от екранните четци с aria-hidden,
            а стиловете идват безплатно от същия CSS заедно с тъмната тема. *@
        <div class="home-hero-visual" aria-hidden="true">

            @* Идентификаторът на пътеката в SVG е различен от този в началната
                страница: препратката на текста по окръжността се търси из целия
                документ, а уникалното име гарантира, че текстът ще закачи
                пътеката в собствения си блок, не в чуждия. *@
            <div class="home-orbit home-orbit-outer">
                <svg viewBox="0 0 400 400" class="home-orbit-svg">
                    <defs>
                        <path id="welcomeOrbitPath"
                              d="M 200, 200 m -186, 0 a 186,186 0 1,1 372,0 a 186,186 0 1,1 -372,0" />
                    </defs>
                    <circle cx="200" cy="200" r="186" class="home-orbit-guide" />
                    <text class="home-orbit-text">
                        <textPath href="#welcomeOrbitPath" startOffset="0"
                                  textLength="1168" lengthAdjust="spacing">
                            ЗАБЕЛЕЖИ • ПОДАЙ СИГНАЛ • ПРОМЕНИ ГРАДА • ЗАБЕЛЕЖИ • ПОДАЙ СИГНАЛ • ПРОМЕНИ ГРАДА •
                        </textPath>
                    </text>
                </svg>
            </div>

            <div class="home-orbit home-orbit-inner">
                <svg viewBox="0 0 400 400" class="home-orbit-svg">
                    <circle cx="200" cy="200" r="150" class="home-orbit-ticks" />
                    <circle cx="200" cy="50" r="3" class="home-orbit-dot-accent" />
                </svg>
            </div>

            <div class="home-visual-circle home-circle-inner"></div>

            <div class="home-visual-card">
                <div class="home-visual-icon">⌖</div>

                <div>
                    <span class="home-visual-small">ТВОЯТ ГРАД</span>
                    <strong>Твоят глас.</strong>

                    <span class="home-visual-caption">
                        Твоята възможност за промяна.
                    </span>
                </div>
            </div>

        </div>

    </section>
</div>

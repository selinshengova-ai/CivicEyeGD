
@page
@model CivicEyeGD.Pages.IndexModel
@{
    ViewData["Title"] = "Начало";
}

<section class="civic-page">
    <div class="civic-hero">
        <div class="hero-content">
            <span class="eyebrow">
                <span class="status-dot"></span>
                CIVIC TECHNOLOGY · ГОЦЕ ДЕЛЧЕВ
            </span>

            <h1>По-добър град<br />започва с <span>един сигнал.</span></h1>

            <p>
                Забеляза нередност? Отбележи я на картата.
                Заедно можем да направим градската среда по-добра.
            </p>

            <div class="hero-actions">
                <a href="#reports" class="btn-civic-primary">
                    Разгледай сигналите <span>→</span>
                </a>
                <a href="#city-map" class="btn-civic-secondary">
                    Виж картата
                </a>
            </div>
        </div>

        <div class="hero-visual" aria-label="Илюстрация на карта с градски сигнали">
            <div class="map-orbit orbit-one"></div>
            <div class="map-orbit orbit-two"></div>
            <div class="map-symbol">
                <span>◎</span>
            </div>
            <div class="floating-label label-top">
                <span class="mini-dot green"></span>
                Градска среда
            </div>
            <div class="floating-label label-bottom">
                <span class="mini-dot blue"></span>
                Всеки сигнал е важен
            </div>
        </div>
    </div>

    <section class="stats-grid" aria-label="Обобщение на сигналите">
        <article class="stat-card">
            <div class="stat-top">
                <span>Всички сигнали</span>
                <span class="stat-icon">◎</span>
            </div>
            <div class="stat-number">@Model.TotalReports</div>
            <div class="stat-note">Общо регистрирани сигнали</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>Нови сигнали</span>
                <span class="stat-icon blue-icon">＋</span>
            </div>
            <div class="stat-number">@Model.NewReports</div>
            <div class="stat-note">Очакват преглед</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>В процес</span>
                <span class="stat-icon orange-icon">↻</span>
            </div>
            <div class="stat-number">@Model.InProgressReports</div>
            <div class="stat-note">Работата продължава</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>Решени</span>
                <span class="stat-icon green-icon">✓</span>
            </div>
            <div class="stat-number">@Model.ResolvedReports</div>
            <div class="stat-note">Приключени сигнали</div>
        </article>
    </section>

    <section class="content-section" id="city-map">
        <div class="section-heading">
            <div>
                <span class="section-kicker">РАЗГЛЕДАЙ ГРАДА</span>
                <h2>Сигнали на картата</h2>
                <p>Открий проблемите и разгледай подадените сигнали.</p>
            </div>
            <span class="demo-badge">Картата предстои</span>
        </div>

        <div class="map-placeholder">
            <div class="map-grid-pattern"></div>
            <div class="map-message">
                <div class="map-pin-icon">⌖</div>
                <h3>Картата на Гоце Делчев</h3>
                <p>Тук ще добавим интерактивна карта с реалните местоположения на сигналите.</p>
                <span>Следваща стъпка: Leaflet + OpenStreetMap</span>
            </div>
        </div>
    </section>

    <section class="content-section" id="reports">
        <div class="section-heading reports-heading">
            <div>
                <span class="section-kicker">ОТ ОБЩНОСТТА</span>
                <h2>Последни сигнали</h2>
                <p>Сигнали, заредени от базата данни на CivicEye GD.</p>
            </div>
            <span class="text-link">Последни 5 сигнала</span>
        </div>

        <div class="reports-list">
            @if (Model.Reports.Count > 0)
            {
                @foreach (var report in Model.Reports)
                {
                    var statusClass = report.Status switch
                    {
                        "Решен" => "status-resolved",
                        "В процес" => "status-progress",
                        _ => "status-new"
                    };

                    <article class="report-card">
                        <div class="report-category-icon road-icon">◎</div>

                        <div class="report-info">
                            <div class="report-title-row">
                                <h3>@report.Title</h3>
                                <span class="report-status @statusClass">
                                    @report.Status
                                </span>
                            </div>

                            <p>@report.Address</p>

                            <div class="report-meta">
                                <span>@report.Category</span>
                                <span>•</span>
                                <span>@report.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>

                            <p>@report.Description</p>
                        </div>

                        <span class="report-arrow">→</span>
                    </article>
                }
            }
            else
            {
                <article class="report-card">
                    <div class="report-category-icon road-icon">◎</div>
                    <div class="report-info">
                        <h3>Все още няма подадени сигнали</h3>
                        <p>Когато бъде подаден първият сигнал, той ще се появи тук.</p>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="call-to-action">
        <div>
            <span class="section-kicker">ТВОЯТ ГРАД. ТВОЯТ ГЛАС.</span>
            <h2>Забеляза проблем?</h2>
            <p>Скоро ще можеш да подаваш сигнали директно през CivicEye GD.</p>
        </div>
        <a href="#reports" class="btn-civic-primary">
            Разгледай сигналите <span>→</span>
        </a>
    </section>

    <footer class="civic-footer">
        <div class="footer-brand">
            <span class="brand-eye">◎</span> CivicEye <strong>GD</strong>
        </div>
        <p>Концепция за по-добра градска среда · Гоце Делчев</p>
    </footer>
</section>


@page
@model CivicEyeGD.Pages.IndexModel

@{
    ViewData["Title"] = "Начало";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />

<style>
    #city-map {
        width: 100%;
        height: 430px;
        min-height: 320px;
        border-radius: 16px;
        overflow: hidden;
        z-index: 1;
        background: #e8eef0;
    }

    .map-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 14px;
        font-size: 0.9rem;
    }

    .map-legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .legend-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: inline-block;
    }

    .legend-new {
        background: #2563eb;
    }

    .legend-progress {
        background: #ea580c;
    }

    .legend-resolved {
        background: #16a34a;
    }

    .map-empty-message {
        margin-top: 12px;
        font-size: 0.9rem;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        #city-map {
            height: 340px;
        }
    }
</style>

<section class="civic-page">
    <div class="civic-hero">
        <div class="hero-content">
            <span class="eyebrow">
                <span class="status-dot"></span>
                CIVIC TECHNOLOGY · ГОЦЕ ДЕЛЧЕВ
            </span>

            <h1>По-добър град<br />започва с <span>един сигнал.</span></h1>

            <p>
                Забеляза нередност? Отбележи я на картата.
                Заедно можем да направим градската среда по-добра.
            </p>

            <div class="hero-actions">
                <a asp-page="/Create" class="btn-civic-primary">
                    ＋ Подай сигнал
                </a>

                <a href="#reports" class="btn-civic-secondary">
                    Разгледай сигналите
                </a>

                <a href="#map-section" class="btn-civic-secondary">
                    Виж картата
                </a>
            </div>
        </div>

        <div class="hero-visual" aria-label="Илюстрация на карта с градски сигнали">
            <div class="map-orbit orbit-one"></div>
            <div class="map-orbit orbit-two"></div>

            <div class="map-symbol">
                <span>◎</span>
            </div>

            <div class="floating-label label-top">
                <span class="mini-dot green"></span>
                Градска среда
            </div>

            <div class="floating-label label-bottom">
                <span class="mini-dot blue"></span>
                Всеки сигнал е важен
            </div>
        </div>
    </div>

    <section class="stats-grid" aria-label="Обобщение на сигналите">
        <article class="stat-card">
            <div class="stat-top">
                <span>Всички сигнали</span>
                <span class="stat-icon">◎</span>
            </div>
            <div class="stat-number">@Model.TotalReports</div>
            <div class="stat-note">Общо регистрирани сигнали</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>Нови сигнали</span>
                <span class="stat-icon blue-icon">＋</span>
            </div>
            <div class="stat-number">@Model.NewReports</div>
            <div class="stat-note">Очакват преглед</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>В процес</span>
                <span class="stat-icon orange-icon">↻</span>
            </div>
            <div class="stat-number">@Model.InProgressReports</div>
            <div class="stat-note">Работата продължава</div>
        </article>

        <article class="stat-card">
            <div class="stat-top">
                <span>Решени</span>
                <span class="stat-icon green-icon">✓</span>
            </div>
            <div class="stat-number">@Model.ResolvedReports</div>
            <div class="stat-note">Приключени сигнали</div>
        </article>
    </section>

    <section class="content-section" id="map-section">
        <div class="section-heading">
            <div>
                <span class="section-kicker">РАЗГЛЕДАЙ ГРАДА</span>
                <h2>Сигнали на картата</h2>
                <p>
                    Разгледай градските проблеми и местоположенията
                    на подадените сигнали.
                </p>
            </div>

            <span class="demo-badge">OpenStreetMap</span>
        </div>

        <div id="city-map"
             role="application"
             aria-label="Интерактивна карта на Гоце Делчев">
        </div>

        <div class="map-legend">
            <span class="map-legend-item">
                <span class="legend-dot legend-new"></span>
                Подаден
            </span>

            <span class="map-legend-item">
                <span class="legend-dot legend-progress"></span>
                В процес
            </span>

            <span class="map-legend-item">
                <span class="legend-dot legend-resolved"></span>
                Решен
            </span>
        </div>

        <p class="map-empty-message" id="map-message" aria-live="polite">
            Картата се зарежда...
        </p>
    </section>

    <section class="content-section" id="reports">
        <div class="section-heading reports-heading">
            <div>
                <span class="section-kicker">ОТ ОБЩНОСТТА</span>
                <h2>Последни сигнали</h2>
                <p>Сигнали, заредени от базата данни на CivicEye GD.</p>
            </div>

            <a asp-page="/Create" class="text-link">
                ＋ Нов сигнал
            </a>
        </div>

        <div class="reports-list">
            @if (Model.Reports.Count > 0)
            {
                @foreach (var report in Model.Reports)
                {
                    var statusClass = report.Status switch
                    {
                        "Решен" => "status-resolved",
                        "В процес" => "status-progress",
                        _ => "status-new"
                    };

                    <article class="report-card">
                        <div class="report-category-icon road-icon">◎</div>

                        <div class="report-info">
                            <div class="report-title-row">
                                <h3>@report.Title</h3>

                                <span class="report-status @statusClass">
                                    @report.Status
                                </span>
                            </div>

                            <p>@report.Address</p>

                            <div class="report-meta">
                                <span>@report.Category</span>
                                <span>•</span>
                                <span>@report.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>

                            <p>@report.Description</p>
                        </div>

                        <span class="report-arrow">→</span>
                    </article>
                }
            }
            else
            {
                <article class="report-card">
                    <div class="report-category-icon road-icon">◎</div>

                    <div class="report-info">
                        <h3>Все още няма подадени сигнали</h3>
                        <p>
                            Можеш да бъдеш първият, който ще подаде сигнал
                            за проблем в градската среда.
                        </p>

                        <a asp-page="/Create" class="text-link">
                            Подай първия сигнал →
                        </a>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="call-to-action">
        <div>
            <span class="section-kicker">ТВОЯТ ГРАД. ТВОЯТ ГЛАС.</span>
            <h2>Забеляза проблем?</h2>
            <p>
                Подай сигнал за проблем в градската среда
                и помогни за по-добър Гоце Делчев.
            </p>
        </div>

        <div>
            <a asp-page="/Create" class="btn-civic-primary">
                ＋ Подай сигнал
            </a>
        </div>
    </section>
</section>

<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    (function () {
        function showMapError(message) {
            const messageElement = document.getElementById("map-message");

            if (messageElement) {
                messageElement.textContent = message;
            }
        }

        function initializeMap() {
            const mapElement = document.getElementById("city-map");

            if (!mapElement) {
                return;
            }

            if (typeof L === "undefined") {
                showMapError(
                    "Leaflet не се зареди. Провери интернет връзката и достъпа до CDN."
                );
                console.error("Leaflet не е зареден: обектът L липсва.");
                return;
            }

            const map = L.map("city-map").setView([41.5667, 23.7333], 15);

            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            showMapError(
                "Картата е заредена. Все още няма сигнали с координати за показване."
            );

            setTimeout(function () {
                map.invalidateSize();
            }, 200);

            window.addEventListener("resize", function () {
                map.invalidateSize();
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializeMap);
        } else {
            initializeMap();
        }
    })();
</script>

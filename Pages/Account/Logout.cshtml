@page
@model CivicEyeGD.Pages.Account.LogoutModel
@{
    Layout = "_WelcomeLayout";
    ViewData["Title"] = "Изход";

    // Проверката е с безопасно четене: ако обектът за самоличност изобщо
    // липсва, резултатът е невярно, а не грешка в изпълнението. Тя дели
    // страницата на два случая - с активна сесия и без такава - за да не се
    // показва бутон за изход на човек, който не е влязъл.
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

@* Изходът е страница с форма, а не обикновена връзка. Връзка може да се
   задейства от чужда страница или от скрита снимка в нея и така някой отвън
   би затварял сесиите на потребителите. При POST заявката минава през
   защитния токен срещу междинна заявка (CSRF), който ASP.NET добавя сам към
   формата по-долу, и сървърът я приема само ако идва от сайта. *@

@* Тук няма админско меню, а публичното оформление: след изхода човек остава
   обикновен посетител и не бива да вижда бутони за действия по сигнали. *@
<div class="home-page">
    <section class="home-hero">
        <div class="home-hero-content">

            @* Малкият надпис над заглавието казва в кой отдел на системата е
               човек; точката до него е само украса и не носи смисъл. *@
            <span class="home-eyebrow">
                <span class="home-eyebrow-dot"></span>
                CIVICEYE GD · СЕСИЯ
            </span>

            @if (isSignedIn)
            {
                <h1>Излизаш от акаунта</h1>

                <p class="home-intro">
                    Изходът минава през POST форма с предпазен токен, затова
                    бутона е тук, а не в обикновена връзка: така никоя външна
                    страница не може да те изкара от акаунта ти.
                </p>

                @* Формата не носи видима стойност за попълване - изходът няма
                   нужни данни. Смисълът ѝ е само методът: тя изпраща
                   защитния токен, за да е сигурно, че бутонът е натиснат от
                   тук. Затварянето на сесията изтрива бисквитата за вход, а
                   след него човек отново вижда публичното лице на сайта. *@
                <form method="post" class="home-account-actions">
                    <div class="home-account-buttons">
                        @* Стрелката е отбелязана като украса с ARIA, за да не
                           я обявява екранният четец след всяко име на бутон;
                           смисъла носи само текстът „Излез сега“. *@
                        <button type="submit" class="home-button-primary">
                            Излез сега
                            <span aria-hidden="true">→</span>
                        </button>

                        @* Отказът е обикновена връзка, защото тя нищо не
                           променя: който не натисне бутона, остава влязъл. *@
                        <a asp-page="/Reports" class="home-button-secondary">
                            Остави ме вътре
                        </a>
                    </div>
                </form>
            }
            else
            {
                @* Вторият случай е за човек без активна сесия: няма какво да
                   се затваря, затова вместо бутон за изход му се предлагат
                   входът и публичните сигнали. *@
                <h1>Не си влязъл в акаунта</h1>

                <p class="home-intro">
                    Нямаш активна сесия, няма какво да затваряме. Сигналите и
                    картата се гледат и без вход.
                </p>

                <div class="home-account-actions">
                    <div class="home-account-buttons">
                        <a asp-page="/Account/Login" class="home-button-primary">
                            Вход
                            <span aria-hidden="true">→</span>
                        </a>

                        <a asp-page="/Reports" class="home-button-secondary">
                            Към сигналите
                        </a>
                    </div>
                </div>
            }

        </div>
    </section>
</div>

@page
@model CivicEyeGD.Pages.Account.ProfileModel

@{
    ViewData["Title"] = "Профил";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-9 col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h1 class="h3 fw-bold mb-2">Профил</h1>

                    <p class="text-muted small mb-4">
                        @User.Identity?.Name
                    </p>

                    @if (Model.Changed)
                    {
                        @* Успехът не е червен ред: той идва по адреса на
                           страницата, след като формата вече е изпратена,
                           за да не може да се сбърка с грешка. *@
                        <div class="alert alert-success small" role="status">
                            Паролата е сменена.
                        </div>
                    }

                    <form method="post">
                        @* Както на вход и регистрация: тук идват грешките,
                           които не принадлежат на едно конкретно поле, а
                           aria-live ги прочита и на екранния четец. *@
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             aria-live="polite">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.CurrentPassword"
                                   class="form-label">
                                Сегашна парола
                            </label>

                            @* current-password, не new-password: браузърът
                               трябва да предложи запазената парола на сайта
                               точно тук, а не на полетата за новата. *@
                            <input asp-for="Input.CurrentPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Input.CurrentPassword"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword"
                                   class="form-label">
                                Нова парола
                            </label>

                            <input asp-for="Input.NewPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Поне 8 символа" />

                            <span asp-validation-for="Input.NewPassword"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Потвърди новата парола
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Повтори новата парола" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <p class="small text-muted mt-n3 mb-4">
                            Паролата трябва да е поне 8 символа и да съдържа
                            цифра и малка буква.
                        </p>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Смени паролата
                        </button>
                    </form>

                    @* Връзката е тук, а не в менюто: въпросът се сменя рядко,
                       но е единственото, което остава, когато паролата е
                       загубена — пощенски сървър в проекта няма, затова друг
                       път за възстановяване не съществува. *@
                    <p class="text-center small mt-4 mb-0">
                        <a asp-page="/Account/SecurityQuestion"
                           class="text-success fw-semibold text-decoration-none">
                            Въпрос за сигурност
                        </a>
                    </p>

                    <p class="text-center small mt-2 mb-0 text-muted">
                        Зададен от тук въпрос позволява нова парола да се
                        сложи без сегашната. Ако няма зададен, профилът не
                        може да бъде възстановен.
                    </p>

                    <p class="text-center small mt-3 mb-0">
                        <a asp-page="/MyReports"
                           class="text-success fw-semibold text-decoration-none">
                            Моите сигнали
                        </a>
                    </p>

                    @* Пътят към изтриването е тук, а не в менюто: той е
                       рядко действие и всяка препратка в шапката би била
                       канцеларска бъркотия. Политиката за поверителност
                       обещава право на забравяне, а обещание без връзка
                       към него остава текст. *@
                    <p class="text-center small mt-2 mb-0">
                        <a asp-page="/Account/Delete"
                           class="text-muted text-decoration-none">
                            Изтрий профила
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

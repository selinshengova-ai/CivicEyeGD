@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@model CivicEyeGD.Pages.Account.ForgotPasswordModel

@{
    // Публичното оформление, както на вход и регистрация: човекът тук е
    // точно извън профила си, затова админското меню няма какво да му върши работа.
    Layout = "_WelcomeLayout";

    ViewData["Title"] = "Забравена парола";
}

@* Възстановяването е анонимно по същата причина като входа: без изключение
   глобалният FallbackPolicy от Program.cs би поискал влязъл потребител, за
   да се покаже страницата, от която се влиза обратно. *@

@* Формата минава през ограничението „forms“ — до 30 изпращания от един IP
   адрес за минута — и през броенето на грешните опити, което важи и за
   входа: пет сгрешени отговора заключават профила за 10 минути. *@

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 70vh;">
        <div class="col-12 col-sm-9 col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <a asp-page="/Welcome"
                           class="text-success text-decoration-none fw-bold fs-5">
                            CivicEye <span class="text-dark">GD</span>
                        </a>

                        <h1 class="h3 fw-bold mt-4 mb-2">Забравена парола</h1>

                        <p class="text-muted small">
                            Отговори на въпроса, който си задал от профила си,
                            и напиши нова парола.
                        </p>
                    </div>

                    @* Пощенски сървър в проекта няма, затова линк за
                       подновяване по имейл не може да бъде изпратен. Това е
                       казано на човека вместо прехвърлено в съобщение за
                       грешка: по-честно е да се обясни пътят, отколкото да
                       се чака письмо, което никога не идва. *@
                    <div class="alert alert-secondary small">
                        Сайтът няма пощенски сървър, затова не изпраща линк по
                        имейл. Идентичността се доказва с въпроса за сигурност,
                        който се задава от <strong>Профил → Въпрос за
                        сигурност</strong>. Профил, на който въпросът не е
                        зададен, не може да бъде възстановен оттук.
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             aria-live="polite">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                   class="form-label">
                                Имейл
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.QuestionKey"
                                   class="form-label">
                                Въпрос
                            </label>

                            @* Списъкът идва от RecoveryQuestions, не е
                               преписан тук: ако двете копия се разминат,
                               човекът вижда един въпрос, а сървърът пази
                               друг и отговорът му никога не би минал.
                               Стойност е ключът, не текстът. *@
                            <select asp-for="Input.QuestionKey"
                                    class="form-select">
                                <option value="">Избери въпрос…</option>

                                @foreach (var option in Model.Options)
                                {
                                    <option value="@option.Key"
                                            selected="@(option.Key == Model.Input.QuestionKey ? "selected" : null)">
                                        @option.Text
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="Input.QuestionKey"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Answer"
                                   class="form-label">
                                Отговор
                            </label>

                            @* autocomplete е off: мениджърът на пароли няма
                               какво да предлага тук, а подсказката би разкрила
                               отговора на всеки, застанал зад рамото. *@
                            <input asp-for="Input.Answer"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="Какъвто си го задал" />

                            <span asp-validation-for="Input.Answer"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword"
                                   class="form-label">
                                Нова парола
                            </label>

                            <input asp-for="Input.NewPassword"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Поне 8 символа" />

                            <span asp-validation-for="Input.NewPassword"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Потвърди новата парола
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Повтори новата парола" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <p class="small text-muted mb-4">
                            Паролата трябва да е поне 8 символа и да съдържа
                            цифра и малка буква.
                        </p>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Възстанови паролата
                        </button>
                    </form>

                    <p class="text-center small mt-4 mb-0">
                        <a asp-page="/Account/Login"
                           class="text-success fw-semibold text-decoration-none">
                            ← Обратно към входа
                        </a>
                    </p>

                    <p class="text-center small mt-2 mb-0">
                        Нямаш профил?
                        <a asp-page="/Account/Register"
                           class="text-success fw-semibold text-decoration-none">
                            Регистрация
                        </a>
                    </p>

                    @* И двата реда са истина за кода, не обещание: грешните
                       отговори минават през същото заключване като грешните
                       влизания, а след успешно възстановяване новата парола
                       се доказва на входа. *@
                    <p class="text-center small mt-3 mb-0 text-muted">
                        След 5 грешни опита профилът се заключва за 10 минути.
                        Всички останали влезли браузъри се отписват.
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

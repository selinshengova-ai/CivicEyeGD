
@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@model CivicEyeGD.Pages.Account.RegisterModel

@{
    // И тук е публичното оформление: новият човек няма права, затова не
    // трябва да вижда менюто за влезли и админските бутони.
    Layout = "_WelcomeLayout";

    // Заглавието служи само за табката на браузъра; на екрана заглавието е
    // отделният h1, който екранните четци объявяват като начало.
    ViewData["Title"] = "Регистрация";
}

@* Разрешението за анонимен достъп в началото на файла е задължително: в
   Program.cs всяка страница изисква влязъл потребител, а създаването на
   профил е точното място, от което се тръгва. *@

@* Формите тук минават през същото ограничение за честота: до 30 изпращания
   от един IP адрес за минута. Без него би било възможно базата да се напълни
   с хиляди фалшиви профили за броени минути. *@

@* Картата остава тясна на голям монитор и се разгъва на цяла ширина в
   телефона: три полета едно под друго се четат лесно само когато не са
   разтеглени през целия екран. *@

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 70vh;">
        <div class="col-12 col-sm-9 col-md-6 col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <a asp-page="/Welcome"
                           class="text-success text-decoration-none fw-bold fs-5">
                            CivicEye <span class="text-dark">GD</span>
                        </a>

                        <h1 class="h3 fw-bold mt-4 mb-2">
                            Създай профил
                        </h1>

                        <p class="text-muted small">
                            Регистрирай се в CivicEye GD.
                        </p>
                    </div>

                    @* Създаването на профил става само с POST. При GET
                       паролата би се описала в адреса на страницата и би
                       останала в историята на браузъра и в дневника на
                       сървъра. *@

                    <form method="post">
                        @* Защитният токен срещу междинна заявка (CSRF) не се
                           описва с ръка: ASP.NET го добавя сам като скрито
                           поле към всяка POST форма. Без него сървърът
                           отхвърля заявката, защото не може да разбере дали
                           формата идва от сайта или от чужда страница. *@

                        @* Общите грешки се показват на едно място: че такъв
                           имейл вече съществува, че паролата не минава
                           правилата или че правата не се записват. Грешките
                           за конкретно поле се изписват под самото поле. *@
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <div class="mb-3">
                            @* Етикетът е обвързан с полето, а не е свободен
                               текст: щракване върху думата фокусира полето, а
                               екранният четец съобщава кое поле какво е. *@
                            <label asp-for="Input.Email"
                                   class="form-label">
                                Имейл
                            </label>

                            @* Имейлът е едновременно и потребителското име в
                               ASP.NET Identity, затова подсказката за
                               автопопълване е username. На сървъра се проверява
                               дали вече няма профил с този адрес: ако двама го
                               ползват, не би се разбрало кой точно влиза. *@
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label">
                                Парола
                            </label>

                            @* Подсказката new-password казва на браузъра да не
                               слага запазената парола на сайта, а да предложи
                               нова. Затова е и на двете полета: при създаване на
                               профил старата парола няма място тук. *@

                            @* Минимумът от осем символа съвпада с правилата в
                               Program.cs: поне една цифра и една малка буква,
                               без задължителни знаци. Те са меки, защото
                               потребителите са жители на града, а не служители
                               с корпоративни изисквания. *@
                            <input asp-for="Input.Password"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Поне 8 символа" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            @* Второто поле за парола е нужно само защото
                               първото е прикрито с точки: грешка с една буква
                               не се вижда и човек би разбрал за нея чак при
                               първия следващ вход. Сравнението на двете
                               стойности се проверява и в браузъра, и на
                               сървъра, защото браузърът може да е с изключена
                               проверка. *@
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Потвърди паролата
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Повтори паролата" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        @* Текстът за паролата е човешки, не само машинен:
                           правилата стоят и в Program.cs, и в горната
                           валидация, но без този ред човек разбира за
                           цифрата и малката буква чак след като е получил
                           грешка. *@
                        <p class="small text-muted mt-n3 mb-3">
                            Паролата трябва да е поне 8 символа и да съдържа
                            цифра и малка буква.
                        </p>

                        @* Една точка за личните данни, а не отметка: тук се
                           събира само имейл, име и парола, за които страницата
                           „Поверителност“ обяснява какво се прави. Отметка за
                           съгласие, която никой код не проверява, би била
                           украса. *@
                        <p class="small text-muted mb-4">
                            Създавайки профил, приемаш начина, по който се
                            съхраняват данните ти — описан е на страницата
                            <a asp-page="/Privacy"
                               class="text-success fw-semibold text-decoration-none">
                                Поверителност
                            </a>.
                        </p>

                        @* При регистрацията няма скрито поле за адрес на
                           връщане, за разлика от входа: след създаването кодът
                           на страницата вписва човека веднага и го праща към
                           началната страница. Новият профил получава правата на
                           обикновен жител, а ако записването на тези права се
                           провали, профилът се изтрива - не трябва да остава
                           адрес без права, с който не може да се свърши работа.
                           Потвърждение по имейл не се изисква: приложението
                           няма пощенски сървър, а линк, който никога не идва,
                           би оставил човека извън сайта. *@
                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Създай профил
                        </button>
                    </form>

                    @* Адресите се генерират от правилата за маршрутизация, а
                       не са описани с ръка, затова остават верни и ако
                       приложението се пусне в подпапка на сайта. Линкът към
                       входа е тук, защото опитът за регистрация на вече
                       съществуващ адрес е честа работа. *@
                    <p class="text-center small mt-4 mb-0">
                        Вече имаш профил?
                        <a asp-page="/Account/Login"
                           class="text-success fw-semibold text-decoration-none">
                            Вход
                        </a>
                    </p>

                    <p class="text-center small mt-3 mb-0">
                        @* Назад може и човек, който е предумислил: сигналите
                           и картата се гледат и без профил. *@
                        <a asp-page="/Welcome"
                           class="text-muted text-decoration-none">
                            ← Обратно към началната страница
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@* Скриптовете за проверка се качват само на страниците с форми, за да не ги
   теглят страниците без форми. Те дават само бърза обратна връзка в браузъра:
   сървърът проверява правилата отново, защото данните могат да се изпратят и
   без отворена страница, а решението за валидност остава за сървъра. *@
@section Scripts {
    @* Същата частица се ползва и при вход, за да не се поддържат две копия
       на препратките към библиотеките на jQuery. *@
    <partial name="_ValidationScriptsPartial" />
}

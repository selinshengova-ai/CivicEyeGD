
@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@model CivicEyeGD.Pages.Account.LoginModel

@{
    // Тук е публичното оформление, а не админското: човек, който още не е
    // влязъл, не трябва да вижда меню с бутони, за които все още няма права.
    Layout = "_WelcomeLayout";

    // Заглавието отива само в табката на браузъра. На самия екран заглавният
    // ред е отделното h1 под логото, за да го намират екранните четци.
    ViewData["Title"] = "Вход";
}

@* Изключението в началото на файла е задължително. В Program.cs е записано,
   че всяка страница изисква влязъл потребител, а формата за вход трябва да
   се вижда и от излезлите. Без изключение сайтът би поискал вход, за да
   покаже страницата, от която се влиза. *@

@* В класа на тази страница стои и ограничението за честота на формите: един
   IP адрес може да изпрати до 30 заявки за една минута. То отсява масовото
   пробване на пароли, а за бавните опити се грижи заключването на акаунта
   след пет неуспешни входа. *@

@* Широчината на картата следва екрана: в телефона тя заема цялата ширина, а
   на голям монитор остава тясна колона. Форма с две полета не бива да се
   разтяга през целия екран, защото се чете и пипа по-трудно. *@

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 70vh;">
        <div class="col-12 col-sm-9 col-md-6 col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <a asp-page="/Welcome"
                           class="text-success text-decoration-none fw-bold fs-5">
                            CivicEye <span class="text-dark">GD</span>
                        </a>

                        <h1 class="h3 fw-bold mt-4 mb-2">Вход</h1>

                        <p class="text-muted small">
                            Влез в профила си.
                        </p>
                    </div>

                    @* Входът се изпраща само с POST. При GET полетата се
                       качват в адреса на страницата, а той остава в
                       историята на браузъра и в дневника на сървъра -
                       парола не трябва да се озовава там. *@

                    <form method="post">
                        @* Токенът за защита от междинна заявка (CSRF) не се
                           пише с ръка: ASP.NET го добавя сам към всяка POST
                           форма като скрито поле. Без него сървърът отхвърля
                           заявката, защото не може да разбере дали формата
                           е изпратена от сайта или от чужда страница. *@

                        @* Адресът за връщане идва като параметър в URL
                           адреса и се пази в скрито поле, за да не се
                           изгуби след първата грешна парола. Класът на
                           страницата го приема само ако е адрес вътре в
                           сайта: отворен пренасочващ адрес би позволил вход
                           да изпрати човека към чужда страница. *@
                        <input type="hidden" asp-for="ReturnUrl" />

                        @* Тук се показват само грешките, които не принадлежат
                           на конкретно поле: грешна комбинация от имейл и
                           парола и заключен акаунт. Грешките за отделно поле
                           се изписват под самото поле, за да е ясно кое не е
                           попълнено. *@
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <div class="mb-3">
                            @* Етикетът е свързан с полето, а не написан като
                               свободен текст: щракване върху думата „Имейл“
                               фокусира полето, а екранният четец съобщава кое
                               какво е. Подсказката в самото поле не стига,
                               защото изчезва, щом човек започне да пише. *@
                            <label asp-for="Input.Email"
                                   class="form-label">
                                Имейл
                            </label>

                            @* Имейлът е едновременно и потребителското име в
                               ASP.NET Identity, затова подсказката за
                               автопопълване е username: браузърът предлага
                               само името, а не паролата. Видът email вади
                               правилната клавиатура на телефона и прави
                               първата проверка още в браузъра. *@
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            @* Съобщението за грешка е под полето и идва от
                               правилата в класа: липсващ адрес или адрес без
                               формат на имейл. *@
                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label">
                                Парола
                            </label>

                            @* Видът password прикрива символите на екрана. В
                               самия код на страницата няма записана парола:
                               полето е винаги празно, а единственото, което
                               може да го попълни, е браузърът или мениджърът
                               на пароли по подсказката current-password, ако
                               човек сам е решил да я запази. *@
                            <input asp-for="Input.Password"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Въведи паролата си" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        @* Отметката „Запомни ме“ променя само вида на
                           бисквитата за вход: без нея тя важи до затваряне на
                           браузъра, с нея се записва с краен срок и човек
                           остава влязъл след рестарт на машината. На споделен
                           компютър в библиотеката не трябва да се отбелязва. *@
                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label small">
                                Запомни ме
                            </label>
                        </div>

                        @* Бутонът е от тип submit в самата форма, а не
                           отделна препратка с JavaScript: така се запазва и
                           входът с клавиш Enter, и работата при спрян
                           JavaScript, и защитният токен се изпраща редом с
                           полетата. Цялата ширина го прави лесен за пипане с
                           палец на телефон. *@
                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Вход
                        </button>
                    </form>

                    @* Адресите не са написани с ръка, а се генерират от
                       правилата за маршрутизация, затова остават верни и ако
                       страниците се преместят, и ако приложението се пусне в
                       подпапка на сайта. Линкът към регистрация е там, защото
                       човек без профил не трябва да гадае адреса ѝ. *@
                    <p class="text-center small mt-4 mb-0">
                        Нямаш профил?
                        <a asp-page="/Account/Register"
                           class="text-success fw-semibold text-decoration-none">
                            Регистрация
                        </a>
                    </p>

                    @* Журито отваря сайта без поканa и не знае с какво да влезе.
                       Подсказката сочи къде са описани демонстрационните профили,
                       но не повтаря нито имейл, нито парола: числата се дават на
                       комисията на хартия, а не на публичен екран. *@
                    <p class="text-center small mt-3 mb-0 text-muted">
                        За преглед на системата: демонстрационните профили са
                        описани в документацията на проекта — Таблица 7.
                    </p>

                    @* Редът за заключването не е измислица: той е същото,
                       което програмата на Identity прави при пет сгрешени
                       опита. Отделна страница „Забравена парола“ не е
                       направена, защото приложеният пощенски сървър го няма
                       — линк за подновяване, който не идва, би бил по-зле от
                       липсващия линк. *@
                    <p class="text-center small mt-2 mb-0 text-muted">
                        Сметката се заключва за 10 минути след 5 грешни опита
                        и се отключва сама. Подновяване на парола по имейл
                        няма — виж раздела „бъдещо развитие“ в документацията.
                    </p>

                    @* Отказът от входа тоже е нормален път: част от хората са
                       дошли да гледат картата и сигналите, а за това не се
                       изисква профил. *@
                    <p class="text-center small mt-3 mb-0">
                        <a asp-page="/Welcome"
                           class="text-muted text-decoration-none">
                            ← Обратно към началната страница
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@* Скриптовете за проверка се качват само на страниците с форми, а не в
   общото оформление, защото останалите страници не ги използват и не трябва
   да ги теглят. Проверката в браузъра дава веднага обратна връзка, но не
   замества проверката на сървъра: всеки може да изпрати данните направо,
   без да отваря страницата изобщо. *@
@section Scripts {
    @* Една и съща частица се използва тук и при регистрация, за да не се
       поддържат два пъти препратките към библиотеките на jQuery. *@
    <partial name="_ValidationScriptsPartial" />
}

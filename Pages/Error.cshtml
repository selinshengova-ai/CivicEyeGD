@*
    CivicEye GD — екранът, който посреща грешките.
    Кодът на състоянието, заглавието и описанието ги решава моделът зад
    страницата; тук няма условия за конкретни номера — каквото подготви
    моделът, това се изписва, а липсваща стойност остава просто празна.
*@

@page
@model ErrorModel
@{
    // Опростената обвивка без меню е избрана умишлено: при грешка не знаем
    // кое в приложението е засегнато, затова екранът трябва да зависи от
    // възможно най-малко негови части — без навигация, която изисква права.
    Layout = "_WelcomeLayout";
    // Заглавието на табата идва от модела и се сменя според състоянието,
    // за да е различно в историята на браузъра при 404 и при 500.
    ViewData["Title"] = Model.Title;
}

<div class="home-page">
    @* Екранът ползва класовете на hero секцията от началната страница:
        грешката изглежда като част от сайта, без нито ред нов CSS и без
        нищо ново за изучаване от объркания потребител. *@
    <section class="home-hero">
        <div class="home-hero-content">

            <span class="home-eyebrow">
                <span class="home-eyebrow-dot"></span>
                CIVICEYE GD · ГРЕШКА @Model.StatusCodeValue
            </span>

            <h1>@Model.Title</h1>

            <p class="home-intro">@Model.Description</p>

            <div class="home-account-actions">
                <p>Продължи накъдето тръгна.</p>

                @* Двата бутона покриват и двете състояния на посетителя:
                    влезлият се връща в пълния интерфейс на началната страница,
                    а гостът — към публичния входен екран; и двата пътя са живи
                    дори когато първоначалната заявка е била грешна. *@
                <div class="home-account-buttons">
                    <a asp-page="/Index" class="home-button-primary">
                        Към началото
                        <span aria-hidden="true">→</span>
                    </a>

                    <a asp-page="/Welcome" class="home-button-secondary">
                        Публична страница
                    </a>
                </div>
            </div>

            @* Номерът на заявката се печата само когато моделът го разреши:
                той е за справка при разговор за конкретния инцидент, а тагът
                code го маркира като машинен текст, който не се превежда. *@
            @if (Model.ShowRequestId)
            {
                <div class="home-hero-note">
                    <span aria-hidden="true">◎</span>
                    Номер на заявката за справка: <code>@Model.RequestId</code>
                </div>
            }

        </div>
    </section>
</div>

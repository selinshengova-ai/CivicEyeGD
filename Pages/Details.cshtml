@page "{id:int}"
@model CivicEyeGD.Pages.DetailsModel
@{
    ViewData["Title"] = Model.Report?.Title ?? "Сигнал";

    // Кой може да гласува и защо не, се решава тук, за да не се
    // различават надписите от правилата в модела.
    var CurrentUserCanVote = Model.IsSignedIn
        && !Model.CurrentUserIsAuthor
        && Model.Report is not null
        && !ReportStatuses.IsClosed(Model.Report.Status);

    // Приключеният сигнал няма какво да чака от общината, затова числото
    // му се показва като факт от миналото, а не като етикет за действие.
    var IsClosedReport = Model.Report is not null
        && ReportStatuses.IsClosed(Model.Report.Status);

    // Изречението стои под самото число, затова глаголът трябва да е в
    // същия род и число като субекта; при нула пък няма кой какво да твърди.
    var ConfirmationsSentence = Model.ConfirmationCount switch
    {
        0 => "Все още няма потвърждения от други граждани.",
        1 => "гражданин потвърждава, че проблемът съществува.",
        _ => "граждани потвърждават, че проблемът съществува."
    };

    var VotingUnavailableText = !Model.IsSignedIn
        ? "Трябва да влезеш в акаунта си, за да гласуваш."
        : Model.CurrentUserIsAuthor
            ? "Като подател не участваш в оценката на собствения си сигнал."
            : "Сигналът е приключен и не приема повече гласове.";
}

<section class="details-page">
    <div class="details-container">

        @if (Model.ErrorMessage is not null)
        {
            <div class="details-alert details-alert-error">@Model.ErrorMessage</div>
        }
        @if (Model.SuccessMessage is not null)
        {
            <div class="details-alert details-alert-success">@Model.SuccessMessage</div>
        }

        <a asp-page="/Reports" class="details-back">
            <span aria-hidden="true">←</span> Всички сигнали
        </a>

        @if (Model.Report is not null)
        {
            <div class="details-header">
                <div>
                    <span class="details-category">@Model.Report.Category</span>
                    <h1>@Model.Report.Title</h1>
                    <p class="details-address">
                        <span aria-hidden="true">⌖</span> @Model.Report.Address
                    </p>
                </div>
                <div class="details-priority@(IsClosedReport ? " details-priority-closed" : "")">
                    @if (IsClosedReport)
                    {
                        <span class="details-priority-label">@Model.Report.Status</span>
                        <span class="details-priority-score">приключен · @Model.PriorityScore / 100</span>
                    }
                    else
                    {
                        <span class="details-priority-label">@Model.PriorityLabel</span>
                        <span class="details-priority-score">@Model.PriorityScore / 100</span>
                    }
                </div>
            </div>

            <div class="details-grid">
                <div class="details-main">
                    <div class="details-description">
                        <h2>Описание</h2>
                        <p>@Model.Report.Description</p>
                    </div>

                    @if (Model.Report.Images.Count > 0)
                    {
                        <div class="details-images">
                            <h2>Снимки</h2>
                            <div class="details-images-grid">
                                @foreach (var image in Model.Report.Images)
                                {
                                    <a href="javascript:void(0)" 
                                       class="open-image-modal" 
                                       data-image-src="/report-images/@image.Id">
                                        <img src="/report-images/@image.Id" alt="Снимка към сигнала" />
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="details-history">
                        <h2>История на статуса</h2>
                        @if (Model.Report.StatusHistories.Count == 0)
                        {
                            <p class="details-muted">Все още няма промени по статуса.</p>
                        }
                        else
                        {
                            <div class="timeline">
                                @foreach (var entry in Model.Report.StatusHistories.OrderByDescending(h => h.ChangedAt))
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <strong>
                                                @if (string.IsNullOrEmpty(entry.OldStatus))
                                                {
                                                    <text>@entry.NewStatus</text>
                                                }
                                                else
                                                {
                                                    <text>@entry.OldStatus → @entry.NewStatus</text>
                                                }
                                            </strong>
                                            <span>@entry.ChangedAt.ToMomentText()</span>
                                            @if (Model.HistoryAuthorLabels.TryGetValue(entry.Id, out var authorLabel))
                                            {
                                                <span class="timeline-author">@authorLabel</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                            {
                                                <span class="timeline-comment">@entry.Comment</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <aside class="details-sidebar">
                    <div class="details-card details-breakdown">
                        <h2>Как се получава @Model.PriorityScore / 100</h2>
                        @{
                            var parts = Model.Breakdown!;
                            var raw = parts.SeverityPoints + parts.ConfirmationPoints + parts.AdminPoints;
                        }
                        <dl class="details-breakdown-list">
                            <dt>Средна сериозност @parts.UsedSeverity.ToString("0.00") от 5</dt>
                            <dd>@parts.SeverityPoints.ToString("0.##") т. <span>(по 20 т. на степен)</span></dd>

                            <dt>@parts.CappedConfirmations @BulgarianPlural.Of(parts.CappedConfirmations, "потвърждение", "потвърждения")</dt>
                            <dd>@parts.ConfirmationPoints.ToString("0.##") т. <span>(по 3 т., най-много 10)</span></dd>

                            <dt>Корекция на общината</dt>
                            <dd>@parts.AdminPoints.ToString("0.##") т. <span>(0–10)</span></dd>

                            <dt class="details-breakdown-total">Общо @raw.ToString("0.##") от 140</dt>
                            <dd class="details-breakdown-total">@Model.PriorityScore.ToString("0.0") % <span>→ @Model.PriorityLabel@(IsClosedReport ? " (преди сигнала да приключи)" : "")</span></dd>
                        </dl>
                        <p class="details-muted">Оценките и потвържденията на подателя не влизат в сметката.</p>
                    </div>

                    <div class="details-card">
                        <h2>Оценка за сериозност</h2>
                        <div class="details-rating-display">
                            <span class="details-rating-number">@Model.AverageSeverity.ToString("0.0")</span>
                            <span class="details-rating-scale">/ 5</span>
                        </div>
                        <p class="details-muted">@Model.IndependentRaterCount @BulgarianPlural.Of(Model.IndependentRaterCount, "оценка", "оценки") от други граждани</p>

                        @if (CurrentUserCanVote)
                        {
                            <form method="post" asp-page-handler="Rate" asp-route-id="@Model.Report.Id">
                                <p class="details-rating-prompt">
                                    @(Model.CurrentUserHasRated ? "Твоята оценка (можеш да я промениш):" : "Дай своята оценка:")
                                </p>
                                <div class="details-rating-buttons">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <button type="submit" name="rating" value="@i"
                                                class="details-rating-button @(Model.CurrentUserRating == i ? "is-selected" : "")">
                                            @i
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="details-vote-note">
                                @VotingUnavailableText
                                @if (!Model.IsSignedIn)
                                {
                                    <a class="details-login-link"
                                       asp-page="/Account/Login"
                                       asp-route-returnUrl="/Details/@Model.Report.Id">
                                        Влез сега
                                    </a>
                                }
                            </p>
                        }
                    </div>

                    <div class="details-card">
                        <h2>Потвърждения</h2>
                        <div class="details-rating-number">@Model.ConfirmationCount</div>
                        <p class="details-muted">@ConfirmationsSentence</p>

                        @if (ReportStatuses.IsClosed(Model.Report.Status))
                        {
                            <p class="details-confirmed-note">Този сигнал е приключен и не приема нови потвърждения.</p>
                        }
                        else if (Model.CurrentUserHasConfirmed)
                        {
                            <p class="details-confirmed-note">✓ Вече си потвърдил този проблем.</p>
                        }
                        else if (CurrentUserCanVote)
                        {
                            <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Report.Id">
                                <button type="submit" class="details-confirm-button">Потвърди този проблем</button>
                            </form>
                        }
                        else
                        {
                            <p class="details-vote-note">
                                @VotingUnavailableText
                                @if (!Model.IsSignedIn)
                                {
                                    <a class="details-login-link"
                                       asp-page="/Account/Login"
                                       asp-route-returnUrl="/Details/@Model.Report.Id">
                                        Влез сега
                                    </a>
                                }
                            </p>
                        }
                    </div>

                    @if (Model.Report.Latitude.HasValue && Model.Report.Longitude.HasValue)
                    {
                        <div class="details-card">
                            <h2>Местоположение</h2>
                            <a class="details-map-link"
                               href="https://www.openstreetmap.org/?mlat=@Model.Report.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)&mlon=@Model.Report.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)#map=18/@Model.Report.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)/@Model.Report.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               target="_blank" rel="noopener noreferrer">
                                Отвори на картата ↗
                            </a>
                        </div>
                    }
                </aside>
            </div>
        }
    </div>
</section>

<!-- Модален прозорец за снимки -->
<div id="imageModal" class="image-modal">
    <span class="image-modal-close">&times;</span>
    <img class="image-modal-content" id="modalImage" src="" alt="Преглед на снимка" />
</div>

<style>
    /* Модален прозорец */
    .image-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(5px);
    }

    .image-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90vh;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }

    .image-modal-close {
        position: absolute;
        top: 20px;
        right: 40px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        z-index: 10001;
        transition: color 0.2s;
    }

    .image-modal-close:hover {
        color: var(--civic-lime, #d7f36b);
    }

    /* Таймлайн за историята на статуса */
    .timeline {
        position: relative;
        padding-left: 20px;
        margin-top: 15px;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 20px;
        border-left: 2px solid var(--civic-border, #e0e8e1);
        padding-left: 20px;
    }
    .timeline-item:last-child {
        border-left: 2px solid transparent;
        padding-bottom: 0;
    }
    .timeline-dot {
        position: absolute;
        left: -6px;
        top: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--civic-green, #1b4d3e);
        border: 2px solid #fff;
    }
    .timeline-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .timeline-content strong {
        color: var(--civic-green-dark, #12392e);
        font-size: 14px;
    }
    .timeline-content span {
        color: var(--civic-muted, #66766d);
        font-size: 12px;
    }
    .timeline-author {
        font-weight: 600;
    }
    .timeline-comment {
        color: var(--civic-green-dark, #12392e);
        font-size: 13px;
    }

    /* Разбивка на приоритета: числата зад етикета */
    .details-breakdown-list {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px 12px;
        margin: 12px 0;
        font-size: 14px;
    }
    .details-breakdown-list dt {
        color: var(--civic-muted, #66766d);
    }
    .details-breakdown-list dd {
        margin: 0;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .details-breakdown-list dd span {
        display: block;
        font-size: 11px;
        color: var(--civic-muted, #66766d);
    }
    .details-breakdown-total {
        border-top: 1px solid var(--civic-border, #e0e8e1);
        padding-top: 6px;
        font-weight: 700;
        color: var(--civic-green-dark, #12392e);
    }
    .details-vote-note {
        margin-top: 12px;
        font-size: 13px;
        color: var(--civic-muted, #66766d);
    }

    /* Тъмна тема за таймлайна */
    html[data-theme="dark"] .timeline-item {
        border-left-color: var(--dark-border);
    }
    html[data-theme="dark"] .timeline-dot {
        background: var(--dark-accent);
        border-color: var(--dark-surface);
    }
    html[data-theme="dark"] .timeline-content strong {
        color: var(--dark-text);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById("modalImage");
        const closeBtn = document.querySelector(".image-modal-close");
        const imageLinks = document.querySelectorAll(".open-image-modal");

        imageLinks.forEach(link => {
            link.addEventListener("click", function (e) {
                e.preventDefault();
                const src = this.getAttribute("data-image-src");
                if (src) {
                    modal.style.display = "block";
                    modalImg.src = src;
                }
            });
        });

        closeBtn.addEventListener("click", function () {
            modal.style.display = "none";
            modalImg.src = "";
        });

        modal.addEventListener("click", function (e) {
            if (e.target === modal) {
                modal.style.display = "none";
                modalImg.src = "";
            }
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && modal.style.display === "block") {
                modal.style.display = "none";
                modalImg.src = "";
            }
        });
    });
</script>
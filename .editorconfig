# Правилата тук описват формата, в който файловете на проекта вече са
# написани, за да я запази и всеки следващ редактор — и за да не се
# разминава локалното форматиране с това, което вижда хранилището.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# В Markdown два интервала в края на реда означават пренасяне; текстът на
# документите е писан така.
trim_trailing_whitespace = false

[*.{csproj,props,targets,xml,config}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Директивите се подреждат по азбучен ред, а тялото на блок винаги започва
# на нов ред — така изглеждат сегашните файлове.
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:suggestion

[*.{cshtml,html,css,js}]
# Скриптът и стиловете са вложени в разметката с четири интервала;
# вътрешните нива вървят по същата крачка.
indent_size = 4
